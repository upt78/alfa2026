# Для Docker Compose значения уже заданы в docker-compose.yml.
APP_PORT=8001
DATABASE_URL=sqlite:///./credit.db
SEED_PRODUCTS=true
ENABLE_WORKER=true
WORKER_INTERVAL_SECONDS=2
CORS_ORIGINS=http://localhost:7100,http://127.0.0.1:7100
# FRONTEND_DIST=/app/frontend/dist
# Frontend: VITE_API_URL=http://localhost:8001 (только если API на другом origin)
# Для Vite proxy можно задать API_TARGET=http://127.0.0.1:8001
